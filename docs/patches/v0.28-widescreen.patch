+HUD={0x6dd4a0,0x6dd7cf}
+TARGETS=CAMERA|TEXT|HUD|{0x4028b0,0x653630}
+VERSION=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+
+def identity(address):
+    return VERSION if address in TARGETS else ''
